---
import { SITE } from '../data/site';
import type { Lang } from '../data/i18n';

interface Props {
  title?: string;
  text?: string;
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const isAr = lang === 'ar';

const {
  title = isAr ? 'احجز موعدك' : 'Prendre rendez-vous',
  text = isAr
    ? 'تستقبلك العيادة من الاثنين إلى السبت. اختر الوسيلة التي تناسبك: عبر الهاتف، أو على الإنترنت، أو من خلال استمارة الاتصال.'
    : 'Le cabinet vous accueille du lundi au samedi. Choisissez le moyen qui vous convient : par téléphone, en ligne ou via le formulaire de contact.',
} = Astro.props;
---

<section class="section cta-rdv">
  <div class="container">
    <div class="cta-panel">
      <div class="reveal">
        <p class="eyebrow">
          {isAr ? 'استشارة وجراحة، للكبار والأطفال' : 'Consultation et chirurgie, adultes et enfants'}
        </p>
        <h2>{title}</h2>
        <p class="cta-text">{text}</p>
      </div>
      <div class="cta-actions reveal">
        <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="btn btn--primary">
          {isAr ? 'اتصل بنا على ' : 'Appeler le '}<span class={isAr ? 'ltr-num' : undefined}>{SITE.phoneDisplay}</span>
        </a>
        <a href={SITE.medtnUrl} target="_blank" rel="noopener" class="btn btn--ghost-light">
          {isAr ? 'حجز موعد على الإنترنت (Med.tn)' : 'Rendez-vous en ligne (Med.tn)'}
        </a>
        <a href={isAr ? '/ar/contact/' : '/contact/'} class="btn btn--ghost-light">
          {isAr ? 'استمارة الاتصال' : 'Formulaire de contact'}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-rdv {
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .cta-panel {
    background: var(--char-800);
    color: #e8e6e1;
    border-radius: clamp(20px, 3vw, 36px);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    display: grid;
    gap: var(--s-6);
    text-align: center;
    justify-items: center;
  }

  .cta-panel h2 {
    color: #fff;
  }

  .cta-panel .eyebrow {
    color: var(--sand-300);
  }

  .cta-text {
    max-width: 55ch;
    margin-top: var(--s-4);
    color: #cfccc4;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: center;
  }
</style>
