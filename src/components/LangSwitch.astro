---
/**
 * Bascule de langue. Ne s'affiche que si la page courante a une contrepartie
 * traduite : un lien vers une page qui n'existe pas serait pire que pas de lien.
 * Le libellé est toujours écrit dans la langue de destination, jamais dans la
 * langue courante : c'est la convention qui demande le moins d'effort au lecteur.
 */
import { counterpart, UI_AR } from '../data/i18n';

const alt = counterpart(Astro.url.pathname);
---

{
  alt && (
    <a
      class="lang-switch"
      href={alt.href}
      hreflang={alt.lang}
      lang={alt.lang}
      dir={alt.lang === 'ar' ? 'rtl' : 'ltr'}
      aria-label={alt.lang === 'ar' ? UI_AR.langSwitchAriaAr : UI_AR.langSwitchAriaFr}
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
        <path
          d="M2.75 12h18.5M12 2.75c2.4 2.6 3.6 5.7 3.6 9.25s-1.2 6.65-3.6 9.25c-2.4-2.6-3.6-5.7-3.6-9.25S9.6 5.35 12 2.75Z"
          stroke="currentColor"
          stroke-width="1.5"
        />
      </svg>
      <span>{alt.lang === 'ar' ? UI_AR.langSwitchToAr : UI_AR.langSwitchToFr}</span>
    </a>
  )
}

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    padding: 0.42rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }

  .lang-switch:hover,
  .lang-switch:focus-visible {
    border-color: var(--blue-logo);
    color: var(--blue-logo);
    background: var(--blue-soft);
  }

  .lang-switch svg {
    opacity: 0.65;
  }

  /* Sur le menu déroulant mobile, la pastille passe en pleine largeur
     pour s'aligner sur les autres entrées de navigation. */
  @media (max-width: 1199px) {
    .lang-switch {
      justify-content: center;
      width: 100%;
      margin-top: var(--s-3);
      padding-block: 0.7rem;
      font-size: var(--text-sm);
    }
  }
</style>
