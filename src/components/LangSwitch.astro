---
/**
 * Bascule de langue. Ne s'affiche que si la page courante a une contrepartie
 * traduite : un lien vers une page qui n'existe pas serait pire que pas de lien.
 * Le libellé est toujours écrit dans la langue de destination, jamais dans la
 * langue courante : c'est la convention qui demande le moins d'effort au lecteur.
 */
import { counterpart, UI_AR } from '../data/i18n';

const alt = counterpart(Astro.url.pathname);
---

{
  alt && (
    <a
      class="lang-switch"
      href={alt.href}
      hreflang={alt.lang}
      lang={alt.lang}
      dir={alt.lang === 'ar' ? 'rtl' : 'ltr'}
      aria-label={alt.lang === 'ar' ? UI_AR.langSwitchAriaAr : UI_AR.langSwitchAriaFr}
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
        <path
          d="M2.75 12h18.5M12 2.75c2.4 2.6 3.6 5.7 3.6 9.25s-1.2 6.65-3.6 9.25c-2.4-2.6-3.6-5.7-3.6-9.25S9.6 5.35 12 2.75Z"
          stroke="currentColor"
          stroke-width="1.5"
        />
      </svg>
      <span class="lang-full">{alt.lang === 'ar' ? UI_AR.langSwitchToAr : UI_AR.langSwitchToFr}</span>
      <span class="lang-short" aria-hidden="true">{alt.lang === 'ar' ? 'ع' : 'FR'}</span>
    </a>
  )
}

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex-shrink: 0;
    /* Cible tactile : 44px, le standard déclaré du projet. */
    min-height: 44px;
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }

  .lang-switch:hover,
  .lang-switch:focus-visible {
    border-color: var(--blue-logo);
    color: var(--blue-logo);
    background: var(--blue-soft);
  }

  .lang-switch svg {
    opacity: 0.65;
  }

  /*
   * État par défaut : code court. Sur la barre horizontale la place est
   * comptée, et le libellé complet faisait déborder la navigation française
   * de 25px. Le nom entier de la langue reste annoncé aux lecteurs d'écran
   * par aria-label, il n'est donc jamais perdu.
   *
   * Le passage au libellé complet est piloté par Header.astro, dans la même
   * règle qui empile la navigation. Une seule rupture décide des deux, ce qui
   * évite le trou d'un pixel qu'ouvraient deux media queries complémentaires.
   */
  .lang-full {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
