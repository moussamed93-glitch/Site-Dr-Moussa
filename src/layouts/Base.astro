---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/hanken-grotesk';
// Polices arabes : les @font-face sont déclarées pour tout le site, mais les
// fichiers ne sont téléchargés que par les pages qui utilisent réellement ces
// familles, c'est-à-dire les pages en [dir="rtl"]. Les pages françaises ne
// paient donc rien.
import '@fontsource/noto-kufi-arabic/400.css';
import '@fontsource/noto-kufi-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import { SITE } from '../data/site';
import { counterpart, CLINIC_AR, UI_AR, type Lang } from '../data/i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Dates ISO (YYYY-MM-DD) pour les articles de blog. */
  publishedDate?: string;
  modifiedDate?: string;
  /** Exclut la page des moteurs de recherche (pages utilitaires). */
  noindex?: boolean;
  jsonLd?: object[];
  breadcrumbs?: { name: string; href: string }[];
  /** Langue de la page ; pilote lang/dir, hreflang et les libellés d'interface. */
  lang?: Lang;
}

const {
  title,
  description,
  ogImage = '/og-cover.jpg',
  ogType = 'website',
  publishedDate,
  modifiedDate,
  noindex = false,
  jsonLd = [],
  breadcrumbs,
  lang = 'fr',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

/**
 * hreflang : seules les pages qui ont une contrepartie traduite en déclarent.
 * Les liens sont réciproques par construction, puisque les deux versions lisent
 * la même table PAGE_PAIRS. x-default pointe sur le français, langue par défaut.
 */
const alt = counterpart(Astro.url.pathname);
const frHref = alt ? (isAr ? new URL(alt.href, Astro.site).href : canonical) : null;
const arHref = alt ? (isAr ? canonical : new URL(alt.href, Astro.site).href) : null;

const sameAs = [SITE.social.facebook, SITE.social.instagram, SITE.medtnUrl].filter(Boolean);

/**
 * Adresse postale, localisée sur les pages arabes. Le pays et le code postal
 * restent inchangés : ce sont des données normalisées, pas du texte à traduire.
 */
const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: isAr
    ? CLINIC_AR.address.streetAddress
    : `${SITE.address.line1}, ${SITE.address.line2}`,
  addressLocality: isAr ? CLINIC_AR.address.addressLocality : SITE.address.city,
  addressRegion: isAr ? CLINIC_AR.address.addressRegion : SITE.address.region,
  postalCode: SITE.address.postalCode,
  addressCountry: 'TN',
};

const clinicLd = {
  '@context': 'https://schema.org',
  '@type': ['MedicalClinic', 'LocalBusiness'],
  '@id': `${SITE.url}/#clinic`,
  name: SITE.name,
  ...(isAr ? { alternateName: CLINIC_AR.alternateName } : {}),
  inLanguage: lang,
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  image: `${SITE.url}/og-cover.jpg`,
  medicalSpecialty: 'Ophthalmologic',
  priceRange: '$$',
  hasMap: SITE.mapsUrl,
  ...(sameAs.length > 0 ? { sameAs } : {}),
  ...(SITE.geo.latitude && SITE.geo.longitude
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: SITE.geo.latitude,
          longitude: SITE.geo.longitude,
        },
      }
    : {}),
  address: postalAddress,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '14:00',
    },
  ],
  physician: {
    '@type': 'Physician',
    '@id': `${SITE.url}/le-medecin/#physician`,
    name: SITE.doctor,
    ...(isAr ? { alternateName: CLINIC_AR.doctorAlternateName } : {}),
    medicalSpecialty: 'Ophthalmologic',
    telephone: SITE.phone,
    image: `${SITE.url}/og-cover.jpg`,
    priceRange: '$$',
    address: postalAddress,
    worksFor: { '@id': `${SITE.url}/#clinic` },
  },
};

const breadcrumbLd = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      inLanguage: lang,
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.href, Astro.site).href,
      })),
    }
  : null;

const allLd = [clinicLd, ...(breadcrumbLd ? [breadcrumbLd] : []), ...jsonLd];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="3UbACZSMEIsmOFIiDRm9ybxhNxk5MOaj1sy9pRLpBEs" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {frHref && arHref && (
      <>
        <link rel="alternate" hreflang="fr" href={frHref} />
        <link rel="alternate" hreflang="ar" href={arHref} />
        <link rel="alternate" hreflang="x-default" href={frHref} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isAr ? 'ar_TN' : 'fr_TN'} />
    {alt && <meta property="og:locale:alternate" content={isAr ? 'fr_TN' : 'ar_TN'} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}, ${SITE.address.city}, ${SITE.address.region}`} />
    {ogType === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    {ogType === 'article' && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <a href="#contenu" class="skip-link">{isAr ? UI_AR.skipLink : 'Aller au contenu principal'}</a>
    <Header lang={lang} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsappFab lang={lang} />

    <script is:inline>
      // Backoffice : si un lien d'invitation/récupération Netlify Identity
      // atterrit ici, charger le widget et rediriger vers /admin/.
      if (/(invite_token|recovery_token|confirmation_token)=/.test(location.hash)) {
        var s = document.createElement('script');
        s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
        s.onload = function () {
          window.netlifyIdentity.on('init', function (user) {
            if (!user) {
              window.netlifyIdentity.on('login', function () {
                document.location.href = '/admin/';
              });
            }
          });
        };
        document.head.appendChild(s);
      }
    </script>

    <script>
      // Révélation discrète des sections au défilement.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
