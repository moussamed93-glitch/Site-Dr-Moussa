---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaRdv from '../../components/CtaRdv.astro';
import Stars from '../../components/Stars.astro';
import { SITE } from '../../data/site';
import { SERVICES_AR, UI_AR } from '../../data/i18n';
import home from '../../data/home.json';
import homeAr from '../../data/home-ar.json';
import { resolveImage } from '../../lib/images';

// Les photos sont partagées avec la version française : mêmes lieux, mêmes
// personnes. Seuls les textes alternatifs sont réécrits en arabe.
const heroImg = resolveImage(home.heroImage);
const portraitImg = resolveImage(home.medecinImage);
const trustImg = resolveImage(home.trustImage);

// La note vient de l'API Google au moment du build (npm run fetch:reviews).
// Contrairement à la page française, cette page ne rafraîchit pas la valeur
// côté client : elle affiche celle du dernier build, qui est déjà fiable.
const ratingDisplay = SITE.rating.toFixed(1).replace('.', ',');
---

<Base
  lang="ar"
  title="طبيب عيون في أريانة، تونس | الدكتور محمد موسى"
  description="عيادة طب العيون بحي الانطلاقة (منيهلة)، أريانة. للكبار والأطفال: الساد، الزرق، القرنية المخروطية. احجز موعدك عبر الهاتف أو واتساب."
  ogImage="/og-cover.jpg"
>
  <!-- ============ الواجهة ============ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="hero-eyebrow">{homeAr.heroEyebrow}</p>
        <h1>
          {homeAr.heroTitle} <em>{homeAr.heroTitleAccent}</em>
        </h1>
        <p class="hero-lead">{homeAr.heroLead}</p>
        <div class="hero-actions">
          <a href="/ar/contact/" class="btn btn--primary">{UI_AR.cta}</a>
          <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="btn btn--outline">
            اتصل بنا على <span class="ltr-num">{SITE.phoneDisplay}</span>
          </a>
        </div>
        <div class="hero-rating">
          <Stars />
          <span>
            <strong data-avis-note>{ratingDisplay}</strong> · <span data-avis-count>{SITE.reviewCount}</span>
            {' '}{UI_AR.reviewsLabel}
          </span>
          <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="hero-map-link">الاتجاهات</a>
        </div>
      </div>
      <figure class="hero-media reveal">
        <Image
          src={heroImg}
          alt="الدكتور محمد موسى، طبيب عيون بأريانة، أثناء فحص مريض بالمصباح الشقي"
          widths={[480, 800, 1100]}
          sizes="(min-width: 900px) 45vw, 94vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- ============ الخدمات ============ -->
  <section class="section services" aria-labelledby="titre-services">
    <div class="container">
      <div class="services-head reveal">
        <p class="eyebrow">{UI_AR.footerServices}</p>
        <h2 id="titre-services">{homeAr.servicesTitle}</h2>
        <p class="services-intro">{homeAr.servicesIntro}</p>
      </div>
      <ol class="service-list reveal">
        {
          SERVICES_AR.map((s) => (
            <li>
              <a href={`/ar/services/${s.slug}/`}>
                <span class="sl-title">{s.title}</span>
                <span class="sl-arrow" aria-hidden="true">←</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ الطبيب ============ -->
  <section class="section medecin" aria-labelledby="titre-medecin">
    <div class="container medecin-grid">
      <figure class="medecin-media reveal">
        <Image
          src={portraitImg}
          alt="صورة الدكتور محمد موسى، أخصائي طب وجراحة العيون"
          widths={[480, 800]}
          sizes="(min-width: 860px) 40vw, 94vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="medecin-text reveal">
        <p class="eyebrow">الطبيب</p>
        <h2 id="titre-medecin">{homeAr.medecinTitle}</h2>
        <p class="medecin-titles">
          {homeAr.medecinTitles.split('\n').map((line) => (
            <span class="medecin-title-line">{line}</span>
          ))}
        </p>
        <p>{homeAr.medecinText1}</p>
        <p>{homeAr.medecinText2}</p>
      </div>
    </div>
  </section>

  <!-- ============ الثقة ============ -->
  <section class="section trust" aria-labelledby="titre-confiance">
    <div class="container trust-grid">
      <figure class="trust-media reveal">
        <Image
          src={trustImg}
          alt="قاعة الفحص بعيادة طب العيون بحي الانطلاقة، منيهلة"
          widths={[480, 800]}
          sizes="(min-width: 860px) 38vw, 94vw"
          loading="lazy"
          decoding="async"
        />
        <span class="trust-veil" aria-hidden="true"></span>
        <figcaption class="trust-rating">
          <Stars class="trust-stars" />
          <span>
            <strong data-avis-note>{ratingDisplay}</strong> · <span data-avis-count>{SITE.reviewCount}</span>
            {' '}{UI_AR.reviewsLabel}
          </span>
        </figcaption>
      </figure>
      <div class="trust-text reveal">
        <p class="eyebrow">العيادة</p>
        <h2 id="titre-confiance">{homeAr.trustTitle}</h2>
        <p class="trust-manifesto">{homeAr.trustManifesto}</p>
        <a href={SITE.googleReviewsUrl} target="_blank" rel="noopener" class="line-link">
          اطّلع على تقييمات المرضى على Google
        </a>
      </div>
    </div>
  </section>

  <!-- ============ معلومات عملية ============ -->
  <section class="section practical" aria-labelledby="titre-pratique">
    <div class="container">
      <div class="reveal">
        <p class="eyebrow">{homeAr.practicalTitle}</p>
        <h2 id="titre-pratique">{homeAr.accessTitle}</h2>
      </div>
      <dl class="practical-list reveal">
        <div class="practical-row">
          <dt>العنوان</dt>
          <dd>
            <p>{homeAr.accessText}</p>
            <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="line-link">
              افتح الاتجاهات على خرائط Google
            </a>
          </dd>
        </div>
        <div class="practical-row">
          <dt>{UI_AR.footerHours}</dt>
          <dd>
            <ul class="practical-hours">
              <li><span>{UI_AR.hoursWeek}</span><span class="ltr-num">09:00 – 18:00</span></li>
              <li><span>{UI_AR.hoursSat}</span><span class="ltr-num">09:00 – 14:00</span></li>
              <li><span>{UI_AR.hoursSun}</span><span>{UI_AR.closed}</span></li>
            </ul>
          </dd>
        </div>
        <div class="practical-row">
          <dt>{UI_AR.callUs}</dt>
          <dd>
            <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="ltr-num practical-phone">
              {SITE.phoneDisplay}
            </a>
            <p class="practical-note">العيادة متعاقدة مع الكنام (CNAM).</p>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <CtaRdv lang="ar" />
</Base>

<style>
  /* ============ واجهة ============ */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 0.9fr;
    }
  }

  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #80683f;
    margin-bottom: var(--s-3);
  }

  .hero h1 {
    font-size: var(--text-hero);
    line-height: 1.3;
    margin-bottom: var(--s-4);
  }

  .hero h1 em {
    font-style: normal;
    color: var(--terra-600);
  }

  .hero-lead {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: 58ch;
    margin-bottom: var(--s-5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .hero-rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  /* `.line-link` est défini dans le scope de la page d'accueil française :
     il ne s'appliquait pas ici. On reprend la même définition pour que les
     deux versions parlent le même langage visuel. */
  .line-link {
    display: inline-block;
    margin-top: var(--s-5);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--char-800);
    border-bottom: 2px solid var(--terra-500);
    padding-bottom: 3px;
    transition: border-color var(--transition), color var(--transition);
  }

  .line-link:hover {
    color: var(--terra-600);
    border-color: var(--terra-700);
  }

  /* Zone cliquable portée à 44px sans déplacer le texte. */
  .hero-map-link,
  .line-link {
    position: relative;
  }

  .hero-map-link::after,
  .line-link::after {
    content: '';
    position: absolute;
    inset-block: -10px;
    inset-inline: 0;
  }

  .hero-map-link {
    color: var(--terra-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: 20px;
    object-fit: cover;
  }

  /* ============ الخدمات ============ */
  .services-head {
    max-width: 62ch;
    margin-bottom: var(--s-6);
  }

  .services-intro {
    color: var(--ink-soft);
    margin-top: var(--s-3);
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: service;
    border-top: 1px solid var(--line);
  }

  .service-list li {
    border-bottom: 1px solid var(--line);
  }

  .service-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-4);
    font-size: var(--text-lg);
    color: var(--ink);
    transition: color var(--transition), padding var(--transition);
  }

  .service-list a:hover {
    color: var(--blue-logo);
    padding-inline-start: var(--s-3);
  }

  .sl-arrow {
    color: var(--taupe-500);
    font-size: 1.2rem;
  }

  /* ============ الطبيب ============ */
  .medecin-grid,
  .trust-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .medecin-grid {
      grid-template-columns: 0.85fr 1fr;
    }

    .trust-grid {
      grid-template-columns: 0.8fr 1fr;
    }
  }

  .medecin-media :global(img),
  .trust-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: 20px;
    object-fit: cover;
  }

  .medecin-titles {
    display: grid;
    gap: var(--s-1);
    margin-block: var(--s-3) var(--s-4);
    color: #80683f;
    font-size: var(--text-sm);
  }

  .medecin-text p {
    margin-bottom: var(--s-4);
    color: var(--ink-soft);
  }

  /* ============ الثقة ============ */
  .trust-media {
    position: relative;
  }

  .trust-veil {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: linear-gradient(to top, rgba(60, 61, 66, 0.55), transparent 55%);
  }

  .trust-rating {
    position: absolute;
    inset-inline-start: var(--s-4);
    bottom: var(--s-4);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: #fff;
    font-size: var(--text-sm);
  }

  .trust-manifesto {
    color: var(--ink-soft);
    margin-block: var(--s-4);
  }

  /* ============ معلومات عملية ============ */
  /* Pas de cartes : le site construit sa hiérarchie avec des filets et la
     typographie. Chaque ligne est un couple libellé / contenu séparé par un
     filet, comme les listes de la version française. */
  .practical-list {
    margin: var(--s-6) 0 0;
    border-top: 1px solid var(--line);
  }

  .practical-row {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .practical-row {
      grid-template-columns: 14rem 1fr;
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: baseline;
    }
  }

  .practical-row dt {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--taupe-600);
  }

  .practical-row dd {
    margin: 0;
    max-width: 62ch;
  }

  .practical-row p {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    margin-bottom: var(--s-3);
  }

  .practical-hours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .practical-hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .practical-phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--navy-800);
  }

  .practical-note {
    font-size: var(--text-xs);
    margin-bottom: 0;
  }
</style>
